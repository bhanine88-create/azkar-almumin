<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ draws this window before Capacitor or the WebView starts. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#052418</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/launch_wordmark</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:windowSplashScreenBackground">#052418</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/launch_wordmark</item>
        <item name="android:windowBackground">@drawable/window_splash</item>
        <item name="android:statusBarColor">#052418</item>
        <item name="android:navigationBarColor">#052418</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>
