# Build output: Netlify runs `npm run build:web` itself (netlify.toml).
dist/
node_modules/
*.local
coverage/
.DS_Store
*.log
.env*
!.env.example
.ai_temp_scripts/

# The native projects ARE tracked: AndroidManifest.xml, the signing setup, the
# adaptive icon XML and the ProGuard rules are hand-maintained and cannot be
# regenerated by `npx cap add`. Only machine-specific and secret files are
# excluded (android/.gitignore covers build output and local.properties).
ios/

# Signing material — losing these means losing the ability to update the
# existing Play listing; committing them means anyone can publish as you.
android/keystore.properties
*.jks
*.keystore

# Generated intermediates from scripts/generate-brand-assets.mjs
assets/.wordmark-trimmed.png
assets/.web-logo-1024.png

# Built installers copied into play-store/ for handoff.
play-store/*.apk
play-store/*.aab
releases/*.apk
releases/*.sha256
